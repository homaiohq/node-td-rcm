{
  "name": "@homaiohq/td-rcm",
  "version": "0.3.0",
  "description": "",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf types && tsc",
    "build:cjs": "tsup lib/index.js --format cjs --out-dir lib --no-splitting --target node14",
    "deployDocs": "npm run docs && sh ./scripts/deployDocs.sh",
    "docs": "rm -rf docs && jsdoc -p -c .jsdoc.json -R README.md",
    "lint": "eslint lib/**/*.js test/**/*.js",
    "my-prepublish": "npm run build && npm run build:cjs && npm run deployDocs",
    "prepublish": "in-publish && npm run my-prepublish || not-in-publish",
    "test": "ava --verbose"
  },
  "author": "Homaio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:homaiohq/node-td-rcm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "ava": "^0.25.0",
    "docdash": "^2.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "in-publish": "^2.0.1",
    "jsdoc": "^4.0.5",
    "jsdoc-tsimport-plugin": "^1.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "validate.js": "^0.13.1"
  },
  "ava": {
    "files": [
      "test/**/*.js"
    ],
    "source": [
      "lib/**/*.js"
    ]
  }
}
